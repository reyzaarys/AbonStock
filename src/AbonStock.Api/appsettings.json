{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=abonstock_db;Username=abonstock;Password=YOUR_DB_PASSWORD"
  },
  "Seeding": {
    "AutoSeed": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "AbonStock.Api",
    "Audience": "AbonStock.Frontend",
    "SecretKey": "YOUR_JWT_SIGNING_KEY_MINIMUM_32_CHARACTERS_PLACEHOLDER",
    "ExpiryHours": 8
  },
  "Auth": {
    "Users": [
      {
        "Id": "usr_admin",
        "Username": "admin",
        "DisplayName": "Administrator",
        "Role": "Admin"
      },
      {
        "Id": "usr_staff",
        "Username": "staff",
        "DisplayName": "Warehouse Staff",
        "Role": "Staff"
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
